<Window x:Class="FitZoneGymScheduler.Views.DatabaseSetupWindow"
         Icon="/Assets/icon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database Setup"
        Height="650"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#111827">

    <Grid>

        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#111827"
                              Offset="0"/>
                <GradientStop Color="#1E293B"
                              Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Main Card -->
        <Border Width="550"
                Padding="40"
                CornerRadius="20"
                Background="#1F2937"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,30">

                    <TextBlock Text="🗄"
                               FontSize="42"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Database Configuration"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,5"/>

                    <TextBlock Text="Connect FitZone to SQL Server and create the database."
                               FontSize="14"
                               Foreground="#94A3B8"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- SQL Server -->

                <StackPanel Grid.Row="1"
                            Margin="0,0,0,18">

                    <TextBlock Text="SQL Server Instance"
                               Foreground="#CBD5E1"
                               FontWeight="SemiBold"
                               />

                    <ComboBox x:Name="ServerCombo"
                              Height="35"
                              FontSize="14"
                              Padding="10"
                              Background="#374151"
                              Foreground="Black"
                              BorderThickness="0"/>
                </StackPanel>

                <!-- Database Name -->

                <StackPanel Grid.Row="2"
                            Margin="0,0,0,25">

                    <TextBlock Text="Database Name"
                               Foreground="#CBD5E1"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="DbNameText"
                             Height="45"
                             FontSize="14"
                             Padding="12"
                             Text="FitZoneGymDB"
                             Background="#374151"
                             Foreground="White"
                             BorderThickness="0"/>
                </StackPanel>

                <!-- Connection Actions -->

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,25">

                    <Button Content="Test Connection"
                            Width="170"
                            Height="26"
                            Margin="0,0,12,0"
                            FontWeight="SemiBold"
                            Background="#374151"
                            Foreground="White"
                            BorderThickness="0"
                            Click="TestConnection_Click"/>

                    <Button Content="Create Database"
                            Width="170"
                            Height="26"
                            FontWeight="SemiBold"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Click="CreateDatabase_Click"/>
                </StackPanel>

                <!-- Main CTA -->

                <Button Grid.Row="4"
                        Content="Save &amp; Initialize System"
                        Height="55"
                        FontSize="15"
                        FontWeight="Bold"
                        Background="#10B981"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SaveInitialize_Click"
                        Margin="0,0,0,20"/>

                <!-- Status Card -->

                <Border Grid.Row="5"
                        Background="#111827"
                        CornerRadius="12"
                        Padding="15"
                        BorderBrush="#374151"
                        BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="Status"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="StatusText"
                                   Foreground="#34D399"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="Waiting for configuration..."/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>