<Window x:Class="FitZoneGymScheduler.MainWindow"
        Icon="/Assets/icon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FitZoneGymScheduler"
        Title="FitZone Gym Scheduler"
        Height="720"
        Width="1280"
        MinHeight="720"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackgroundBrush}">

    <Grid>

        <!-- Layout -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0"
                Background="#301934">

            <StackPanel Margin="15">

                <TextBlock Text="ANYTIME FITZONE"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="Silver"
                           HorizontalAlignment="Center"
                           Margin="10,20,10,40"/>

                <Button Content="📊 Dashboard"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding DashboardCommand}"
                        Margin="0,5"/>

                <Button Content="👥 Members"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding MembersCommand}"
                        Margin="0,5"/>

                <Button Content="🏋 Exercise Library"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ExerciseLibraryCommand}"
                        Margin="0,5"/>

                <Button Content="📋 Workout Plans"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding WorkoutPlansCommand}"
                        Margin="0,5"/>

                <Button Content="⚡ Saved Plans"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SavedPlansCommand}"
                        
                        Margin="0,20,0,0"/>

                <!-- Admin Only -->
                <Button Content="👤 User Management"
                        Command="{Binding UserManagementCommand}"
                        Margin="0,10,0,0">

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource PrimaryButtonStyle}">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsAdministrator}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </Button.Style>

                </Button>

                <Button Content="🚪 Logout"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LogoutCommand}"
                        Margin="0,10,0,0"/>

            </StackPanel>

        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Column="1"
              Background="{StaticResource PrimaryBackgroundBrush}">

            <!-- Current View -->
            <ContentControl Content="{Binding CurrentView}" />

            <!-- ================= LOADING OVERLAY ================= -->
            <Grid Panel.ZIndex="9999"
      IsHitTestVisible="True"
      Visibility="{Binding Source={x:Static local:App.LoadingService},
                           Path=IsLoading,
                           Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- Dark Background -->
                <Border Background="#AA000000"/>

                <!-- Loading Card -->
                <Border Width="380"
            Height="240"
            Background="#202020"
            BorderBrush="#303030"
            BorderThickness="1"
            CornerRadius="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                    <Grid>

                        <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                            <!-- FitZone Logo Text -->
                            <TextBlock Text="FITZONE"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#00C853"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                            <!-- Spinner -->
                            <Grid Width="80"
                      Height="80">

                                <!-- Background Circle -->
                                <Ellipse Stroke="#404040"
                             StrokeThickness="8"/>

                                <!-- Animated Circle -->
                                <Ellipse Stroke="#00C853"
                             StrokeThickness="8"
                             StrokeDashArray="2 3">

                                    <Ellipse.RenderTransform>
                                        <RotateTransform CenterX="40"
                                             CenterY="40"/>
                                    </Ellipse.RenderTransform>

                                    <Ellipse.Triggers>

                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">

                                            <BeginStoryboard>

                                                <Storyboard RepeatBehavior="Forever">

                                                    <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0"
                                            To="360"
                                            Duration="0:0:1"/>

                                                </Storyboard>

                                            </BeginStoryboard>

                                        </EventTrigger>

                                    </Ellipse.Triggers>

                                </Ellipse>

                            </Grid>

                            <!-- Loading Message -->
                            <TextBlock Margin="0,20,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Text="{Binding Source={x:Static local:App.LoadingService},
                                          Path=Message}"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>
            
        </Grid>

    </Grid>

</Window>