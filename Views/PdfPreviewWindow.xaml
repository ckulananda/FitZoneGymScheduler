<Window x:Class="FitZoneGymScheduler.Views.PdfPreviewWindow"
         Icon="/Assets/icon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workout PDF Preview"
        Height="800"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#EAEAEA">

    <Grid>

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PDF PREVIEW -->
        <ScrollViewer Grid.Row="0">

            <Border
                Width="750"
                Margin="20"
                Padding="40"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1">

                <StackPanel x:Name="PreviewContainer">

                    <!-- HEADER -->

                    <Border
                        Background="#111827"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,20">

                        <StackPanel>

                            <TextBlock
                                Text="FITZONE GYM"
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Center"/>

                            <TextBlock
                                Text="Personalized Workout Plan"
                                FontSize="14"
                                Foreground="#D1D5DB"
                                HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                    <!-- Dynamic workout content will be added here -->

                </StackPanel>

            </Border>

        </ScrollViewer>

        <!-- ACTION BUTTONS -->

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="15">

            <Button
                Content="DOWNLOAD PDF"
                Width="180"
                Height="45"
                Margin="5"
                FontWeight="Bold"
                Click="DownloadPdf_Click"/>

            <Button
                Content="SEND WHATSAPP"
                Width="180"
                Height="45"
                Margin="5"
                FontWeight="Bold"
                Click="SendWhatsapp_Click"/>

            <Button
    Content="CHANGE PDF FOLDER"
    Width="180"
    Height="45"
    Margin="5"
    Click="ChangePdfFolder_Click"/>

        </StackPanel>

    </Grid>

</Window>