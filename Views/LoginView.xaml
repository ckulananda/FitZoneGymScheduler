<UserControl
    x:Class="FitZoneGymScheduler.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#301934">

        <Border Width="573"
                Padding="40"
                Background="#301934"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="25"
                    ShadowDepth="0"
                    Opacity="0.25"/>
            </Border.Effect>

            <StackPanel>

                <!-- HEADER -->

                <Border Width="70"
                        Height="70"
                        CornerRadius="35"
                        Background="White"
                        HorizontalAlignment="Center">

                    <TextBlock Text="🏋"
                               FontSize="28"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>
                </Border>

                <TextBlock Text="ANYTIME FITZONE"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="Silver"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"/>

                <TextBlock Text="Gym Workout Scheduler System"
                           FontSize="14"
                           Foreground="#A0A0A0"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,35"/>

                <!-- USERNAME -->

                <TextBlock Text="Username"
                           Foreground="White"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <Border Background="#2B2B2B"
                        CornerRadius="10"
                        Margin="0,0,0,20">

                    <TextBox Height="45"
                             Padding="12,0"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="White"
                             VerticalContentAlignment="Center"
                             Text="{Binding Username,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                </Border>

                <!-- PASSWORD -->

                <TextBlock Text="Password"
                           Foreground="White"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <Grid Margin="0,0,0,15">

                    <!-- HIDDEN PASSWORD -->

                    <Border Background="#2B2B2B"
                            CornerRadius="10"
                            Visibility="{Binding IsPasswordVisible,
                                Converter={StaticResource BoolToVisibilityConverter},
                                ConverterParameter=False}">

                        <PasswordBox x:Name="PasswordInput"
                                     Height="45"
                                     Padding="12,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="White"
                                     VerticalContentAlignment="Center"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                    </Border>

                    <!-- VISIBLE PASSWORD -->

                    <Border Background="#2B2B2B"
                            CornerRadius="10"
                            Visibility="{Binding IsPasswordVisible,
                                Converter={StaticResource BoolToVisibilityConverter}}">

                        <TextBox Height="45"
                                 Padding="12,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Password,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>

                </Grid>

                <!-- OPTIONS -->

                <Grid Margin="0,0,0,25">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Content="Show Password"
                              Foreground="White"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsPasswordVisible}"/>

                    <CheckBox Grid.Column="1"
                              Content="Remember Me"
                              Foreground="White"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"/>

                </Grid>

                <!-- LOGIN BUTTON -->

                <Button Content="LOGIN"
                        Height="50"
                        Background="Black"
                        FontSize="15"
                        Foreground="White"
                        FontWeight="Bold"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordInput}"/>
                
                <Border Height="0"
                        Background="#303030"
                        />

                <!-- DIVIDER -->

                <!-- SIGNUP -->

                <StackPanel HorizontalAlignment="Center" Height="100">

                    <TextBlock Text="Don't have an account?"
                               Foreground="#A0A0A0"
                               
                               HorizontalAlignment="Center"/>

                    <Button Content="CREATE ACCOUNT"
                            Width="374"
                            Background="Green"
                            Foreground="White"
                            Height="42"
                            Margin="0,12,0,0"
                            Command="{Binding OpenSignUpCommand}" Click="Button_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>