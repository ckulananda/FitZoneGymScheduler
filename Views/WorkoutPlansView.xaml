<UserControl
    x:Class="FitZoneGymScheduler.Views.WorkoutPlansView"
   
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- ========================================================= -->
    <!-- RESOURCES -->
    <!-- ========================================================= -->

    <UserControl.Resources>

        <!-- COLORS -->

        <SolidColorBrush x:Key="PageBackground" Color="#151515"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="CardSecondary" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="CardTertiary" Color="#323232"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF"/>

        <!-- TEXT -->

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- INPUT -->

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- PRIMARY BUTTON -->

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#4F8CFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,14"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- DELETE BUTTON -->

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#C73A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ========================================================= -->
    <!-- MAIN -->
    <!-- ========================================================= -->

    <Grid Background="{StaticResource PageBackground}">

        <Grid.ColumnDefinitions>

            <!-- LEFT -->
            <ColumnDefinition Width="350"/>

            <!-- RIGHT -->
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- LEFT PANEL -->
        <!-- ========================================================= -->

        <Border
            Grid.Column="0"
            Margin="12"
            Background="{StaticResource CardBackground}"
            CornerRadius="18">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Background="#301934">

                <StackPanel Margin="24">

                    <!-- TITLE -->

                    <TextBlock
                        Text="Workout Builder"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"
                        Margin="0,0,0,28"/>

                    <!-- MEMBER -->

                    <TextBlock
                        Text="Select Member"
                        Style="{StaticResource SectionLabelStyle}"/>

                    <Button
    Height="44"
    Content="👤 SELECT MEMBER"
    Command="{Binding OpenMemberSelectorCommand}"
    Background="#4F8CFF"
    Foreground="White"
    FontWeight="SemiBold"/>

                    <!-- PLAN NAME -->

                    <TextBlock
                        Text="Plan Name"
                        Style="{StaticResource SectionLabelStyle}"/>

                    <TextBox
                        Style="{StaticResource InputStyle}"
                        Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- GOAL -->

                    <TextBlock
                        Text="Goal"
                        Style="{StaticResource SectionLabelStyle}"/>

                    <TextBox
                        Style="{StaticResource InputStyle}"
                        Text="{Binding Goal, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- DIFFICULTY -->

                    <TextBlock
                        Text="Difficulty"
                        Style="{StaticResource SectionLabelStyle}"/>

                    <ComboBox
    Style="{StaticResource InputStyle}"
    ItemsSource="{Binding DifficultyLevels}"
                        Foreground="Black"
    SelectedItem="{Binding Difficulty, Mode=TwoWay}" />

                    <!-- NOTES -->

                    <TextBlock
                        Text="Notes"
                        Style="{StaticResource SectionLabelStyle}"/>

                    <TextBox
                        Height="120"
                        Margin="0,0,0,24"
                        Padding="12"
                        Background="#2B2B2B"
                        Foreground="White"
                        BorderBrush="#3C3C3C"
                        BorderThickness="1"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- ADD DAY -->

                    <Button
    Content="➕ ADD DAY"
    Height="50"
    Margin="0,12,0,0"
    Background="#16A34A"
    Foreground="White"
    FontWeight="Bold"
    FontSize="15"
    Command="{Binding AddDayCommand}"
    Style="{StaticResource PrimaryButtonStyle}"
    RenderTransformOrigin="0.5,0.5">

                        <Button.RenderTransform>
                            <ScaleTransform x:Name="scaleTransform"/>
                        </Button.RenderTransform>

                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">

                                        <!-- Pulse Size -->
                                        <DoubleAnimation
                        Storyboard.TargetProperty="RenderTransform.ScaleX"
                        From="1"
                        To="1.06"
                        Duration="0:0:0.8"
                        AutoReverse="True"/>

                                        <DoubleAnimation
                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                        From="1"
                        To="1.06"
                        Duration="0:0:0.8"
                        AutoReverse="True"/>

                                        <!-- Pulse Opacity -->
                                        <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        From="1"
                        To="0.85"
                        Duration="0:0:0.8"
                        AutoReverse="True"/>

                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>

                    </Button>

                    <Button
    Content="💾 SAVE PLAN"
    Height="50"
    Margin="0,12,0,0"
    Background="#2563EB"
    Foreground="White"
    FontWeight="SemiBold"
    FontSize="15"
    Cursor="Hand"
    Command="{Binding SavePlanCommand}">

                        <Button.Effect>
                            <DropShadowEffect
            BlurRadius="12"
            ShadowDepth="2"
            Opacity="0.3"/>
                        </Button.Effect>

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                                                <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.9"/>
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>


                    <!-- PDF PREVIEW -->

                    <Button
    Content="📄 VIEW PDF PREVIEW"
    Height="50"
    Margin="0,12,0,0"
    Background="#7C3AED"
    Foreground="White"
    FontWeight="SemiBold"
    FontSize="15"
    Cursor="Hand"
    Command="{Binding ViewPdfPreviewCommand}">

                        <Button.Effect>
                            <DropShadowEffect
            BlurRadius="10"
            ShadowDepth="2"
            Opacity="0.25"/>
                        </Button.Effect>

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                                                <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.9"/>
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button
    Content="📱 SEND WHATSAPP"
    Height="50"
    Margin="0,12,0,0"
    Background="#25D366"
    Foreground="White"
    FontWeight="SemiBold"
    FontSize="15"
    Cursor="Hand"
    Command="{Binding SendWhatsAppCommand}">

                        <Button.Effect>
                            <DropShadowEffect
            BlurRadius="10"
            ShadowDepth="2"
            Opacity="0.25"/>
                        </Button.Effect>

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                                                <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.9"/>
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>

            </ScrollViewer>

        </Border>

        <!-- ========================================================= -->
        <!-- RIGHT SIDE -->
        <!-- ========================================================= -->

        <Grid Grid.Column="1">

            <Grid.ColumnDefinitions>

                <!-- BUILDER -->
                <ColumnDefinition Width="1.35*"/>

                <!-- PREVIEW -->
                <ColumnDefinition Width="1*"/>

            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- BUILDER -->
            <!-- ========================================================= -->

            <ScrollViewer
                Grid.Column="0"
                VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding WorkoutDays}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Margin="12"
                                Padding="18"
                                Background="{StaticResource CardBackground}"
                                CornerRadius="16">

                                <StackPanel>

                                    <!-- HEADER -->

                                    <Grid Margin="0,0,0,18">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Text="{Binding DayNumber, StringFormat=DAY {0}}"
                                            FontSize="24"
                                            FontWeight="Bold"
                                            Foreground="White"/>

                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                            <CheckBox
                                                Content="Rest Day"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                Margin="0,0,14,0"
                                                IsChecked="{Binding IsRestDay}"/>

                                            <Button
                                                Content="✕"
                                                Command="{Binding RemoveDayCommand}"
                                                Style="{StaticResource DangerButtonStyle}"/>

                                        </StackPanel>

                                    </Grid>

                                    <!-- ADD SECTION -->

                                    <Button
    Content="🏋️ ADD WORKOUT TYPE"
    Height="50"
    Margin="0,12,0,0"
    Background="#15803D"
    Foreground="White"
    FontWeight="SemiBold"
    FontSize="15"
    Cursor="Hand"
    Command="{Binding AddSectionCommand}">

                                        <Button.Effect>
                                            <DropShadowEffect
            BlurRadius="10"
            ShadowDepth="2"
            Opacity="0.25"/>
                                        </Button.Effect>
                                    </Button>

                                    <!-- ================================================= -->
                                    <!-- SECTION LIST -->
                                    <!-- ================================================= -->

                                    <ItemsControl ItemsSource="{Binding Sections}">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <Border
                                                    Margin="0,0,0,18"
                                                    Padding="16"
                                                    Background="{StaticResource CardSecondary}"
                                                    CornerRadius="14">

                                                    <StackPanel>

                                                        <!-- WORKOUT TYPE -->

                                                        <TextBlock
                                                            Text="Workout Type"
                                                            Style="{StaticResource SectionLabelStyle}"/>

                                                        <ComboBox
                                                            Style="{StaticResource InputStyle}"
                                                            Foreground="Black"
                                                            ItemsSource="{Binding SectionTypes}"
                                                            SelectedItem="{Binding SectionName}"/>

                                                        <!-- SELECT EXERCISE -->

                                                        <Button
                                                              Content="🔍 SELECT EXERCISE"
                                                               Height="50"
                                                               Margin="0,12,0,0"
                                                               Background="#0891B2"
                                                              Foreground="White"
                                                              FontWeight="SemiBold"
                                                              FontSize="15"
                                                              Cursor="Hand"
                                                              Command="{Binding OpenExerciseSelectorCommand}">

                                                            <Button.Effect>
                                                                <DropShadowEffect
            BlurRadius="10"
            ShadowDepth="2"
            Opacity="0.25"/>
                                                            </Button.Effect>
                                                        </Button>
                                                        <!-- ================================================= -->
                                                        <!-- HEADER -->
                                                        <!-- ================================================= -->

                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="10"
                                                            Background="{StaticResource CardTertiary}"
                                                            CornerRadius="10">

                                                            <Grid>

                                                                <Grid.ColumnDefinitions>

                                                                    <ColumnDefinition Width="3*"/>
                                                                    <ColumnDefinition Width="1*"/>
                                                                    <ColumnDefinition Width="1.5*"/>
                                                                    <ColumnDefinition Width="2.5*"/>

                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock
                                                                    Text="Exercise"
                                                                    FontWeight="Bold"
                                                                    Foreground="White"/>

                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Text="Sets"
                                                                    FontWeight="Bold"
                                                                    Foreground="White"
                                                                    HorizontalAlignment="Center"/>

                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    Text="Reps/Time"
                                                                    FontWeight="Bold"
                                                                    Foreground="White"
                                                                    HorizontalAlignment="Center"/>

                                                                <TextBlock
                                                                    Grid.Column="3"
                                                                    Text="Notes"
                                                                    FontWeight="Bold"
                                                                    Foreground="White"
                                                                    Margin="10,0,0,0"/>

                                                            </Grid>

                                                        </Border>

                                                        <!-- ================================================= -->
                                                        <!-- EXERCISES -->
                                                        <!-- ================================================= -->

                                                        <ItemsControl ItemsSource="{Binding Exercises}">

                                                            <ItemsControl.ItemTemplate>

                                                                <DataTemplate>
                                                                    <Border
                                                                         Margin="0,0,0,10"
                                                                         Padding="14"
                                                                         Background="#242424"
                                                                         CornerRadius="12">

                                                                        <Grid>

                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="3*"/>
                                                                                <ColumnDefinition Width="1*"/>
                                                                                <ColumnDefinition Width="1.2*"/>
                                                                                <ColumnDefinition Width="2*"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- Exercise Card -->

                                                                            <Border
                                                                              Grid.Column="0"
                                                                               Margin="0,0,12,0"
                                                                                 Padding="12"
                                                                                   Background="#313131"
                                                                                      CornerRadius="10">

                                                                                <StackPanel>

                                                                                    <TextBlock
                                                                                       FontSize="16"
                                                                                        FontWeight="SemiBold"
                                                                                        Foreground="White"
                                                                                         Text="{Binding ExerciseName}" />

                                                                                    <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="#C9C9C9"
                    Text="{Binding TargetArea}" />

                                                                                    <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="#60A5FA"
                    Text="{Binding Difficulty}" />

                                                                                    <Button
    Height="30"
    Margin="0,10,0,0"
    Background="#0891B2"
    Content="🔄 CHANGE"
    FontSize="12"
    FontWeight="SemiBold"
    Command="{Binding OpenExerciseSelectorCommand}" />

                                                                                </StackPanel>

                                                                            </Border>

                                                                            <!-- Sets -->

                                                                            <StackPanel
            Grid.Column="1"
            Margin="0,0,10,0">

                                                                                <TextBlock
                Margin="0,0,0,4"
                FontSize="11"
                Foreground="#AAAAAA"
                Text="SETS" />

                                                                                <TextBox
                Height="38"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Text="{Binding Sets}" />
                                                                            </StackPanel>

                                                                            <!-- Reps -->

                                                                            <StackPanel
            Grid.Column="2"
            Margin="0,0,10,0">

                                                                                <TextBlock
                Margin="0,0,0,4"
                FontSize="11"
                Foreground="#AAAAAA"
                Text="REPS" />

                                                                                <TextBox
                Height="38"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Text="{Binding RepsOrDuration}" />
                                                                            </StackPanel>

                                                                            <!-- Notes -->

                                                                            <StackPanel Grid.Column="3">

                                                                                <TextBlock
                Margin="0,0,0,4"
                FontSize="11"
                Foreground="#AAAAAA"
                Text="NOTES" />

                                                                                <TextBox
                Height="38"
                Padding="10,0"
                VerticalContentAlignment="Center"
                Text="{Binding Notes}" />
                                                                            </StackPanel>

                                                                        </Grid>

                                                                    </Border>

                                                                </DataTemplate>

                                                            </ItemsControl.ItemTemplate>

                                                        </ItemsControl>

                                                    </StackPanel>

                                                </Border>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

            <!-- ========================================================= -->
            <!-- LIVE PREVIEW -->
            <!-- ========================================================= -->

            <!-- ================================================= -->
            <!-- LIVE PDF PREVIEW -->
            <!-- ================================================= -->

            <Border
    Grid.Column="1"
    Background="#F7F7F7"
    Margin="12"
    CornerRadius="16"
    Padding="25">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <Border
            Background="White"
            Padding="30"
            BorderBrush="#DADADA"
            BorderThickness="1">

                        <StackPanel>

                            <!-- TITLE -->

                            <TextBlock
                    Text="{Binding PlanName}"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#222222"/>

                            <!-- MEMBER -->

                            <TextBlock
                    Text="{Binding SelectedMember.FullName}"
                    FontSize="16"
                    Foreground="#555555"
                    Margin="0,6,0,25"/>

                            <!-- GOAL -->

                            <TextBlock
                    Text="{Binding Goal}"
                    FontSize="15"
                    Foreground="#444444"
                    Margin="0,0,0,8"/>

                            <!-- DIFFICULTY -->

                            <TextBlock
                    Text="{Binding Difficulty}"
                    FontSize="14"
                    Foreground="#666666"
                    Margin="0,0,0,25"/>

                            <!-- DAYS -->

                            <ItemsControl
                    ItemsSource="{Binding WorkoutDays}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <StackPanel Margin="0,0,0,30">

                                            <!-- DAY HEADER -->

                                            <Border
                                    Background="#202020"
                                    Padding="10"
                                    CornerRadius="6"
                                    Margin="0,0,0,10">

                                                <TextBlock
                                        Text="{Binding DayNumber, StringFormat=DAY {0}}"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="White"/>

                                            </Border>

                                            <!-- REST DAY -->

                                            <Border
                                    Background="#FFECEC"
                                    BorderBrush="#E18A8A"
                                    BorderThickness="1"
                                    Padding="10"
                                    Margin="0,0,0,12">

                                                <Border.Style>

                                                    <Style TargetType="Border">

                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                        <Style.Triggers>

                                                            <DataTrigger
                                                    Binding="{Binding IsRestDay}"
                                                    Value="True">

                                                                <Setter Property="Visibility" Value="Visible"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Border.Style>

                                                <TextBlock
                                        Text="REST DAY"
                                        Foreground="#B02E2E"
                                        FontWeight="Bold"/>

                                            </Border>

                                            <!-- ================================================= -->
                                            <!-- SECTIONS -->
                                            <!-- ================================================= -->

                                            <ItemsControl
                                    ItemsSource="{Binding Sections}">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <StackPanel Margin="0,0,0,20">

                                                            <!-- SECTION TITLE -->

                                                            <TextBlock
                                                    Text="{Binding SectionName}"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#222222"
                                                    Margin="0,0,0,10"/>

                                                            <!-- TABLE -->

                                                            <Border
                                                    BorderBrush="#DADADA"
                                                    BorderThickness="1">

                                                                <Grid>

                                                                    <Grid.RowDefinitions>

                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>

                                                                    </Grid.RowDefinitions>

                                                                    <!-- HEADER -->

                                                                    <Border
                                                            Grid.Row="0"
                                                            Background="#EFEFEF"
                                                            BorderBrush="#DADADA"
                                                            BorderThickness="0,0,0,1">

                                                                        <Grid Margin="10">

                                                                            <Grid.ColumnDefinitions>

                                                                                <ColumnDefinition Width="3*"/>
                                                                                <ColumnDefinition Width="1*"/>
                                                                                <ColumnDefinition Width="1.5*"/>
                                                                                <ColumnDefinition Width="2.5*"/>

                                                                            </Grid.ColumnDefinitions>

                                                                            <TextBlock
                                                                    Text="Exercise"
                                                                    FontWeight="Bold"/>

                                                                            <TextBlock
                                                                    Grid.Column="1"
                                                                    Text="Sets"
                                                                    FontWeight="Bold"
                                                                    HorizontalAlignment="Center"/>

                                                                            <TextBlock
                                                                    Grid.Column="2"
                                                                    Text="Reps/Time"
                                                                    FontWeight="Bold"
                                                                    HorizontalAlignment="Center"/>

                                                                            <TextBlock
                                                                    Grid.Column="3"
                                                                    Text="Notes"
                                                                    FontWeight="Bold"
                                                                    Margin="10,0,0,0"/>

                                                                        </Grid>

                                                                    </Border>

                                                                    <!-- ROWS -->

                                                                    <ItemsControl
                                                            Grid.Row="1"
                                                            ItemsSource="{Binding Exercises}">

                                                                        <ItemsControl.ItemTemplate>

                                                                            <DataTemplate>

                                                                                <Border
                                                                        BorderBrush="#ECECEC"
                                                                        BorderThickness="0,0,0,1"
                                                                        Padding="10">

                                                                                    <Grid>

                                                                                        <Grid.ColumnDefinitions>

                                                                                            <ColumnDefinition Width="3*"/>
                                                                                            <ColumnDefinition Width="1*"/>
                                                                                            <ColumnDefinition Width="1.5*"/>
                                                                                            <ColumnDefinition Width="2.5*"/>

                                                                                        </Grid.ColumnDefinitions>

                                                                                        <!-- EXERCISE -->

                                                                                        <TextBlock
                                                                                Text="{Binding ExerciseName}"
                                                                                VerticalAlignment="Center"
                                                                                TextWrapping="Wrap"/>

                                                                                        <!-- SETS -->

                                                                                        <TextBlock
                                                                                Grid.Column="1"
                                                                                Text="{Binding Sets}"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>

                                                                                        <!-- REPS -->

                                                                                        <TextBlock
                                                                                Grid.Column="2"
                                                                                Text="{Binding RepsOrDuration}"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>

                                                                                        <!-- NOTES -->

                                                                                        <TextBlock
                                                                                Grid.Column="3"
                                                                                Text="{Binding Notes}"
                                                                                Margin="10,0,0,0"
                                                                                TextWrapping="Wrap"/>

                                                                                    </Grid>

                                                                                </Border>

                                                                            </DataTemplate>

                                                                        </ItemsControl.ItemTemplate>

                                                                    </ItemsControl>

                                                                </Grid>

                                                            </Border>

                                                        </StackPanel>

                                                    </DataTemplate>

