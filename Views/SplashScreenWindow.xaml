<Window x:Class="FitZoneGymScheduler.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#0F172A"
        Width="900"
        Height="500"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="ANYTIME FITZONE"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Gym Workout Management System"
                       FontSize="18"
                       Margin="0,10,0,30"
                       Foreground="#B0B7C3"
                       HorizontalAlignment="Center"/>

            <ProgressBar x:Name="LoadingBar"
                         Width="400"
                         Height="15"
                         Minimum="0"
                         Maximum="100"/>

            <TextBlock x:Name="StatusText"
                       Text="Loading..."
                       Margin="0,15,0,0"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

        </StackPanel>

    </Grid>
</Window>