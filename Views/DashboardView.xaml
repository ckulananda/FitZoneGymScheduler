<UserControl x:Class="FitZoneGymScheduler.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <ScrollViewer Background="#301934"
                  VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25">


            <!-- ======================================= -->
            <!-- Updates -->
            <!-- ======================================= -->

            <Border Background="#1A1A1A"
        CornerRadius="12"
        Padding="15"
        Margin="0,0,0,20">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- PROFILE IMAGE -->
                    <Border Width="50"
                Height="50"
                CornerRadius="25"
                Background="#333"
                Grid.Column="0">

                        <Image Source="{Binding ProfilePicture}"
                   Stretch="UniformToFill"/>
                    </Border>

                    <!-- USER INFO -->
                    <StackPanel Grid.Column="1"
                    Margin="10,0,0,0">

                        <TextBlock Text="{Binding CurrentUserName}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"/>

                        <TextBlock Text="{Binding CurrentUserRole}"
                       Foreground="#AAAAAA"
                       FontSize="12"/>

                        <TextBlock Text="{Binding LoginTime}"
                       Foreground="#777"
                       FontSize="11"/>

                    </StackPanel>

                    <!-- SESSION TIMER -->
                    <StackPanel Grid.Column="2"
                    HorizontalAlignment="Right">

                        <TextBlock Text="Session Time"
                       Foreground="#AAAAAA"
                       FontSize="11"
                       HorizontalAlignment="Right"/>

                        <TextBlock Text="{Binding SessionDuration}"
                       Foreground="#00E5FF"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"/>

                    </StackPanel>

                </Grid>

            </Border>



            <!-- ======================================= -->
            <!-- HEADER -->
            <!-- ======================================= -->

            <TextBlock Text="Gym Dashboard"
                       FontSize="34"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,0,0,25"/>

            <!-- ======================================= -->
            <!-- KPI STRIP -->
            <!-- ======================================= -->

            <UniformGrid Columns="4"
                         Margin="0,0,0,20">

                <!-- MEMBERS -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>

                        <TextBlock Text="Members"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock Text="{Binding TotalMembers}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="{Binding MembersTrendText}"
                                   Foreground="LightGreen"
                                   FontSize="12"/>

                    </StackPanel>
                </Border>

                <!-- ACTIVE -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>

                        <TextBlock Text="Active Now"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock Text="{Binding ActiveMembers}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="{Binding ActiveTrendText}"
                                   Foreground="LightGreen"
                                   FontSize="12"/>

                    </StackPanel>
                </Border>

                <!-- PLANS -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>

                        <TextBlock Text="Workout Plans"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock Text="{Binding TotalWorkoutPlans}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="{Binding PlansTrendText}"
                                   Foreground="LightGreen"
                                   FontSize="12"/>

                    </StackPanel>
                </Border>

                <!-- EXERCISES -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>

                        <TextBlock Text="Exercises"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock Text="{Binding TotalExercises}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="{Binding ExerciseTrendText}"
                                   Foreground="LightGreen"
                                   FontSize="12"/>

                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ======================================= -->
            <!-- RECENT DATA -->
            <!-- ======================================= -->

            <Grid Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- RECENT MEMBERS -->

                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">

                    <StackPanel>

                        <TextBlock Text="Recent Members"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding RecentMembers}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Background="#1F1F1F"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,5">

                                        <StackPanel>

                                            <TextBlock Text="{Binding FullName}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="{Binding FitnessGoal}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <!-- RECENT PLANS -->

                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Recent Workout Plans"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding RecentWorkoutPlans}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Background="#1F1F1F"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,5">

                                        <StackPanel>

                                            <TextBlock Text="{Binding PlanName}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="{Binding Goal}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- ======================================= -->
            <!-- SIMPLE ANALYTICS -->
            <!-- ======================================= -->

            <Grid Margin="0,0,0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- MEMBER GROWTH -->

                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">

                    <StackPanel>

                        <TextBlock Text="Member Growth"
                                   Foreground="White"
                                   FontSize="16"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Are we growing?"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,10"/>

                        <Border Height="240"
                                Background="#1F1F1F"
                                CornerRadius="10"
                                Padding="10">

                            <lvc:CartesianChart
                                Series="{Binding MemberGrowthSeries}"
                                XAxes="{Binding XAxes}"
                                YAxes="{Binding YAxes}" />

                        </Border>

                    </StackPanel>

                </Border>

                <!-- WORKOUT DISTRIBUTION -->

                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Workout Focus"
                                   Foreground="White"
                                   FontSize="16"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="What members train most"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,10"/>

                        <Border Height="240"
                                Background="#1F1F1F"
                                CornerRadius="10"
                                Padding="10">

                            <lvc:PieChart
                                Series="{Binding WorkoutPlanSeries}" />

                        </Border>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- ======================================= -->
            <!-- BAR CHART -->
            <!-- ======================================= -->

            <Border Style="{StaticResource CardStyle}"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="Exercise Breakdown"
                               FontSize="16"
                               Foreground="White"
                               Margin="0,0,0,5"/>

                    <TextBlock Text="Which exercise groups dominate"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               Margin="0,0,0,10"/>

                    <Border Height="260"
                            Background="#1F1F1F"
                            CornerRadius="10"
                            Padding="10">

                        <lvc:CartesianChart
                            Series="{Binding ExerciseSeries}"
                            XAxes="{Binding XAxes}"
                            YAxes="{Binding YAxes}" />

                    </Border>

                </StackPanel>

            </Border>

            <!-- ======================================= -->
            <!-- HUMAN INSIGHT CARD -->
            <!-- ======================================= -->

            <Border Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock Text="What this means"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding InsightText}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>