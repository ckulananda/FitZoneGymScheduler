<UserControl
    x:Class="FitZoneGymScheduler.Views.WorkoutPlansListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#301934">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="Green"
                Padding="20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Saved Workout Plans"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="REFRESH"
                        Width="120"
                        Height="40"
                        Command="{Binding RefreshCommand}"/>

            </Grid>

        </Border>

        <!-- CONTENT -->

        <Border Grid.Row="1"
                Margin="20"
                Background="#222222"
                CornerRadius="8">

            <DataGrid
                ItemsSource="{Binding WorkoutPlans}"
                SelectedItem="{Binding SelectedPlan}"
                AutoGenerateColumns="False"
                HeadersVisibility="Column"
                CanUserAddRows="False"
                IsReadOnly="True"
                BorderThickness="0"
                RowHeight="50"
                GridLinesVisibility="Horizontal"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Background="#222222"
                Foreground="Black"
                FontWeight="Bold">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Height" Value="45"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="10,0"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>

                    <!-- PLAN NAME -->

                    <DataGridTextColumn
                        Header="Plan Name"
                        Binding="{Binding PlanName}"
                        Width="2.5*" />

                    <!-- MEMBER -->

                    <DataGridTextColumn
                        Header="Member"
                        Binding="{Binding Member.FullName}"
                        Width="2*" />

                    <!-- GOAL -->

                    <DataGridTextColumn
                        Header="Goal"
                        Binding="{Binding Goal}"
                        Width="2*" />

                    <!-- DIFFICULTY -->

                    <DataGridTextColumn
                        Header="Difficulty"
                        Binding="{Binding Difficulty}"
                        Width="1.3*" />

                    <!-- CREATED -->

                    <DataGridTextColumn
                        Header="Created"
                        Binding="{Binding CreatedDate}"
                        Width="1.5*" />

                    <!-- ACTIONS -->

                    <DataGridTemplateColumn
                        Header="Actions"
                        Width="330">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <UniformGrid Rows="1"
                                             Columns="4"
                                             HorizontalAlignment="Center"
                                             Margin="5">

                                    <Button
                                        Content="OPEN"
                                        Margin="2"
                                        Height="32"
                                        Command="{Binding DataContext.OpenPlanCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />

                                    <Button
                                        Content="EDIT"
                                        Margin="2"
                                        Height="32"
                                        Command="{Binding DataContext.EditPlanCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />

                                    <Button
                                        Content="COPY"
                                        Margin="2"
                                        Height="32"
                                        Command="{Binding DataContext.DuplicatePlanCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />

                                    <Button
                                        Content="DELETE"
                                        Margin="2"
                                        Height="32"
                                        Background="#C62828"
                                        Foreground="White"
                                        Command="{Binding DataContext.DeletePlanCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />

                                </UniformGrid>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>