<UserControl
    x:Class="FitZoneGymScheduler.Views.MembersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,18,0,10"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#301934">

        <Grid.RowDefinitions>
            <RowDefinition Height="115"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- DASHBOARD CARDS -->

        <UniformGrid Grid.Row="0"
                     Columns="4"
                     Margin="20,20,20,10">

            <Border Background="Green" CornerRadius="22" Margin="6" Padding="15">
                <StackPanel>
                    <TextBlock Text="TOTAL MEMBERS" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding TotalMembers}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Border>

            <Border Background="Green" CornerRadius="22" Margin="6" Padding="15">
                <StackPanel>
                    <TextBlock Text="MALE MEMBERS" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding MaleMembers}" FontSize="20" FontWeight="Bold" Foreground="Blue"/>
                </StackPanel>
            </Border>

            <Border Background="Green" CornerRadius="22" Margin="6" Padding="15">
                <StackPanel>
                    <TextBlock Text="FEMALE MEMBERS" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding FemaleMembers}" FontSize="20" FontWeight="Bold" Foreground="#EC407A"/>
                </StackPanel>
            </Border>

            <Border Background="green" CornerRadius="22" Margin="6" Padding="15">
                <StackPanel>
                    <TextBlock Text="AVERAGE BMI" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding AverageBMI}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <Grid Grid.Row="1" Margin="20,0,20,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->

            <Border Grid.Column="0"
                    Background="#301934"
                    CornerRadius="28"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Background="#301934">

                    <StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">

                            <Border Width="120"
                                    Height="120"
                                    CornerRadius="60"
                                    Background="Green">

                                <TextBlock Text="👤"
                                           FontSize="56"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="Member Profile"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>

                        </StackPanel>

                        <TextBlock Text="PERSONAL INFORMATION" Foreground="White" Style="{StaticResource SectionHeaderStyle}"/>

                        <TextBlock Text="Full Name" Style="{StaticResource LabelStyle}"/>
                        <TextBox Height="27" Text="{Binding FullName}"/>

                        <TextBlock Text="Age" Style="{StaticResource LabelStyle}"/>
                        <TextBox Height="27" Text="{Binding Age}"/>

                        <TextBlock Text="Gender" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Height="27"
                                  SelectedValue="{Binding Gender}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Female"/>
                        </ComboBox>

                        <TextBlock Text="Country" Style="{StaticResource LabelStyle}"/>
                        <TextBox Height="27" Text="{Binding Country}"/>

                        <TextBlock Text="BODY METRICS" Style="{StaticResource SectionHeaderStyle}"/>

                        <TextBlock Text="Height" Style="{StaticResource LabelStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Height="27"
                                     Margin="0,0,8,0"
                                     Text="{Binding Height}"/>

                            <ComboBox Grid.Column="1"
                                      Height="27"
                                      SelectedValue="{Binding HeightUnit}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="cm"/>
                                <ComboBoxItem Content="ft"/>
                                <ComboBoxItem Content="inch"/>
                            </ComboBox>

                        </Grid>

                        <TextBlock Text="Weight" Style="{StaticResource LabelStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="99*"/>
                                <ColumnDefinition Width="155*"/>
                                <ColumnDefinition Width="127*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Height="27"
                                     Margin="0,0,8,0"
                                     Text="{Binding Weight}" Grid.ColumnSpan="2"/>

                            <ComboBox Grid.Column="1"
                                      Height="27"
                                      SelectedValue="{Binding WeightUnit}"
                                      SelectedValuePath="Content" Grid.ColumnSpan="2" Margin="154,0,0,0">
                                <ComboBoxItem Content="kg"/>
                                <ComboBoxItem Content="lb"/>
                            </ComboBox>

                        </Grid>

                        <TextBlock Text="BMI" Style="{StaticResource LabelStyle}"/>
                        <TextBox Height="27"
                                 IsReadOnly="True"
                                 Text="{Binding BMI}"/>

                        <TextBlock Text="BMI Status" Style="{StaticResource LabelStyle}"/>

                        <Border Background="#2E7D32"
                                CornerRadius="14"
                                Padding="10">

                            <TextBlock Text="{Binding BMIWord}"
                                       HorizontalAlignment="Center"
                                       Foreground="White"
                                       FontWeight="Bold"/>

                        </Border>

                        <TextBlock Text="FITNESS DETAILS" Style="{StaticResource SectionHeaderStyle}"/>

                        <TextBlock Text="Fitness Level" Style="{StaticResource LabelStyle}"/>
                        <TextBox Height="27" Text="{Binding FitnessLevel}"/>

                        <TextBlock Text="Fitness Goal" Style="{StaticResource LabelStyle}"/>
                        <TextBox Height="27" Text="{Binding FitnessGoal}"/>

                        <TextBlock Text="CONTACT INFORMATION" Style="{StaticResource SectionHeaderStyle}"/>

                        <TextBlock Text="Phone Number" Style="{StaticResource LabelStyle}"/>
                        <TextBox Height="27" Text="{Binding PhoneNumber}"/>

                        <TextBlock Text="Notes" Style="{StaticResource LabelStyle}"/>

                        <TextBox MinHeight="120"
                                 MaxHeight="250"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Text="{Binding Notes}"/>

                        <UniformGrid Columns="3" Margin="0,20,0,0">

                            <Button Content="SAVE"
                                    Margin="4"
                                    Height="50"
                                    Command="{Binding SaveMemberCommand}"
                                    Background="#2E7D32"/>

                            <Button Content="UPDATE"
                                    Margin="4"
                                    Height="50"
                                    Command="{Binding UpdateMemberCommand}"
                                    Background="#1976D2"/>

                            <Button Content="DELETE"
                                    Margin="4"
                                    Height="50"
                                    Command="{Binding DeleteMemberCommand}"
                                    Background="#D32F2F"/>

                        </UniformGrid>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- RIGHT PANEL -->

            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#301934"
                        CornerRadius="18"
                        Padding="12"
                        Margin="0,0,0,15">

                    <TextBox Height="42"
                             Padding="10"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search Members"/>

                </Border>

                <Border Grid.Row="1"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="24"
                        Padding="10">

                    <DataGrid
                        ItemsSource="{Binding Members}"
                        SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        Foreground="black"
                        HeadersVisibility="Column"
                        BorderThickness="0"
                        RowBackground="white"
                        AlternatingRowBackground="white">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="180"/>
                            <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="60"/>
                            <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="90"/>
                            <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="120"/>
                            <DataGridTextColumn Header="Height" Binding="{Binding Height}" Width="80"/>
                            <DataGridTextColumn Header="H Unit" Binding="{Binding HeightUnit}" Width="80"/>
                            <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="80"/>
                            <DataGridTextColumn Header="W Unit" Binding="{Binding WeightUnit}" Width="80"/>
                            <DataGridTextColumn Header="BMI" Binding="{Binding BMI}" Width="70"/>
                            <DataGridTextColumn Header="BMI Status" Binding="{Binding BMIWord}" Width="120"/>
                            <DataGridTextColumn Header="Fitness Level" Binding="{Binding FitnessLevel}" Width="140"/>
                            <DataGridTextColumn Header="Goal" Binding="{Binding FitnessGoal}" Width="180"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="140"/>
                            <DataGridTextColumn Header="Join Date" Binding="{Binding JoinDate}" Width="160"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="250"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>