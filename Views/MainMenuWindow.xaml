<Window x:Class="FitZoneGymScheduler.Views.MainMenuWindow"
         Icon="/Assets/icon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FitZone"
        Width="1200"
        Height="700"
        MinWidth="1100"
        MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0F172A"
        
        WindowStartupLocation="CenterScreen">
    
    

    <Window.Resources>

        <!-- Window Buttons -->

        <Style x:Key="WindowButtonStyle"
               TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#1F2937"/>
                </Trigger>
            </Style.Triggers>

        </Style>

        <!-- Sidebar Buttons -->

        <Style x:Key="MenuButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="55"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Left"
                                              Margin="20,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#7C3AED"/>
                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <Border CornerRadius="12"
            BorderBrush="#1E293B"
            BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->

            <Grid Grid.Row="0"
                  Background="#111827"
                  MouseLeftButtonDown="TitleBar_MouseDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="FITZONE"
                           Margin="15,0"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button Width="45"
                            Height="45"
                            Content="─"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="MinimizeButton_Click"/>

                    <Button Width="45"
                            Height="45"
                            Content="□"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="MaximizeButton_Click"/>

                    <Button Width="45"
                            Height="45"
                            Content="✕"
                            Click="CloseButton_Click">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource WindowButtonStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#E81123"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                    </Button>

                </StackPanel>

            </Grid>

            <!-- MAIN CONTENT -->

            <Grid Grid.Row="1">
                

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR -->

                <Border Grid.Column="0"
                        Background="#111827">

                    <StackPanel Margin="20">

                        <TextBlock Text="FITZONE"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,10,0,30"/>

                        <Button Content="LOGIN"
                                Margin="0,0,0,15"
                                Style="{StaticResource MenuButtonStyle}" Click="OpenLogin_Click"/>

                        <Button Content="DATABASE SETUP"
                                Margin="0,0,0,15"
                                Style="{StaticResource MenuButtonStyle}" Click="Button_Click_1"/>

                        <Button Content="ABOUT DEVELOPER"
                                Margin="0,0,0,15"
                                Style="{StaticResource MenuButtonStyle}" Click="Button_Click_3"/>

                        <Button Content="EXIT"
                                Margin="0,0,0,15"
                                Style="{StaticResource MenuButtonStyle}" Click="Exit_Click"/>

                        <Separator Margin="0,25,0,20"/>

                        <TextBlock Text="Version 1.0.0"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="© 2026 FitZone"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <!-- RIGHT CONTENT -->

                <Grid Grid.Column="1"

                      Margin="25">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="280"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->

                    <Border Grid.Row="0"
                            CornerRadius="15"
                            Background="#1E293B"
                            Padding="25">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Replace with logo later -->

                            <!-- Replace with logo later -->

                            <TextBlock Text="Gym Management System"
                                       FontSize="18"
                                       Foreground="#CBD5E1"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="FitZone Management Platform"
                                       FontSize="16"
                                       Foreground="#94A3B8"
                                       Margin="0,15,0,0"
                                       HorizontalAlignment="Center" Height="36"/>
                            <Image Source="/Assets/AnytimeFitnessLogo.jpg"
                             Width="487"
                             Height="170"
                             Stretch="Uniform"/>

                        </StackPanel>

                    </Border>

                    <!-- INFO CARDS -->

                    <Grid Grid.Row="1"
                          Margin="0,20,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- COMPANY CARD -->

                        <Border Grid.Column="0"
                                Margin="0,0,10,0"
                                Background="#111827"
                                CornerRadius="15"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Company Information"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,20"/>

                                <TextBlock Text="Anytime Fitness Pvt Ltd"
                                           FontSize="16"
                                           Foreground="White"/>

                                <TextBlock Text="Fitness Club Management"
                                           Foreground="#CBD5E1"
                                           Margin="0,10,0,0"/>

                                <TextBlock Text="Membership Management"
                                           Foreground="#CBD5E1"
                                           Margin="0,5,0,0"/>

                                <TextBlock Text="Workout Plans"
                                           Foreground="#CBD5E1"/>

                                <TextBlock Text="Attendance Tracking"
                                           Foreground="#CBD5E1"/>

                                <TextBlock Text="Billing &amp; Payments"
                                           Foreground="#CBD5E1"/>

                            </StackPanel>

                        </Border>

                        <!-- APP CARD -->

                        <Border Grid.Column="1"
                                Margin="10,0,0,0"
                                Background="#111827"
                                CornerRadius="15"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Application Information"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,20"/>

                                <TextBlock Text="FitZone V1.0"
                                           FontSize="16"
                                           Foreground="White"/>

                                <TextBlock Text="WPF + C# + SQL Server"
                                           Foreground="#CBD5E1"
                                           Margin="0,10,0,0"/>

                                <TextBlock Text="MVVM Architecture"
                                           Foreground="#CBD5E1"/>

                                <TextBlock Text="Developer"
                                           Foreground="White"
                                           Margin="0,20,0,0"/>

                                <TextBlock Text="Chamodha Dhananjana"
                                           Foreground="#CBD5E1"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Grid>

            </Grid>

        </Grid>

    </Border>

</Window>