<UserControl x:Class="FitZoneGymScheduler.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#301934">

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.3*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- LEFT: USERS LIST -->
        <!-- ================================================= -->
        <Border Grid.Column="0"
                Background="#1A1A1A"
                CornerRadius="14"
                Padding="15"
                Margin="0,0,10,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="User Management"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Select a user to edit details"
                               FontSize="12"
                               Foreground="#888"/>
                </StackPanel>

                <!-- SEARCH -->
                <TextBox Grid.Row="1"
                         Height="40"
                         Margin="0,0,0,10"
                         Padding="10"
                         Background="#222"
                         Foreground="White"
                         BorderBrush="#333"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- USERS TABLE -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="55"
                          GridLinesVisibility="None">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#151515"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#222"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2C3E50"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding FullName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Username"
                                            Binding="{Binding Username}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Role"
                                            Binding="{Binding Role}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding IsActive}"
                                            Width="100"/>
                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- RIGHT: EDIT PANEL -->
        <!-- ================================================= -->
        <Border Grid.Column="1"
                Background="#1A1A1A"
                CornerRadius="14"
                Padding="20">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- PROFILE IMAGE -->
                    <Border Width="110"
                            Height="110"
                            CornerRadius="55"
                            Background="#2A2A2A"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,10">

                        <Image Source="{Binding EditProfilePicture}"
                               Stretch="UniformToFill"/>
                    </Border>

                    <Button Content="Change Picture"
                            Height="35"
                            Margin="0,0,0,15"
                            Command="{Binding BrowseImageCommand}"/>

                    <!-- FULL NAME -->
                    <TextBlock Text="Full Name" Foreground="#999"/>
                    <TextBox Text="{Binding EditFullName}" Height="35" Margin="0,5,0,10"/>

                    <!-- USERNAME -->
                    <TextBlock Text="Username" Foreground="#999"/>
                    <TextBox Text="{Binding EditUsername}" Height="35" Margin="0,5,0,10"/>

                    <!-- EMAIL -->
                    <TextBlock Text="Email" Foreground="#999"/>
                    <TextBox Text="{Binding EditEmail}" Height="35" Margin="0,5,0,10"/>

                    <!-- PHONE -->
                    <TextBlock Text="Phone" Foreground="#999"/>
                    <TextBox Text="{Binding EditPhoneNumber}" Height="35" Margin="0,5,0,10"/>

                    <!-- ROLE -->
                    <TextBlock Text="Role" Foreground="#999"/>
                    <ComboBox ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding EditRole}"
                              Height="35"
                              Margin="0,5,0,10"/>

                    <!-- PASSWORD -->
                    <TextBlock Text="New Password (optional)" Foreground="#999"/>
                    <PasswordBox Height="35"
                                 Margin="0,5,0,15"/>

                    <!-- SAVE BUTTON -->
                    <Button Content="💾 Save Changes"
                            Height="42"
                            Background="#2980B9"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding SaveUserCommand}"/>

                    <!-- ACTIONS -->
                    <Button Content="Deactivate"
                            Height="40"
                            Margin="0,10,0,5"
                            Background="#C0392B"
                            Foreground="White"
                            Command="{Binding DeactivateUserCommand}"/>

                    <Button Content="Activate"
                            Height="40"
                            Margin="0,0,0,5"
                            Background="#27AE60"
                            Foreground="White"
                            Command="{Binding ActivateUserCommand}"/>

                    <Button Content="🗑 Remove"
                            Height="40"
                            Background="#B71C1C"
                            Foreground="White"
                            Command="{Binding DeleteUserCommand}"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</UserControl>