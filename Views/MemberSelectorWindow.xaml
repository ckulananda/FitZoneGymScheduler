<Window
    x:Class="FitZoneGymScheduler.Views.MemberSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Member Selector"
    Width="1000"
    Height="700"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- BUTTON STYLE -->

        <Style TargetType="Button">

            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="RenderTransformOrigin"
                    Value="0.5,0.5"/>

            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1"
                                    ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Opacity"
                            Value="0.92"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- LISTBOX ITEM -->

        <Style TargetType="ListBoxItem">

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Opacity"
                            Value="0.95"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <!-- MAIN CONTAINER -->

    <Border
        Background="#151515"
        CornerRadius="18"
        BorderBrush="#303030"
        BorderThickness="1"
        Margin="10">

        <Grid Margin="25">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- HEADER -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">

                <TextBlock
                    Text="👤 MEMBER SELECTOR"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="White"/>

                <TextBlock
                    Margin="0,5,0,0"
                    Text="Search and choose a member for the workout plan"
                    FontSize="13"
                    Foreground="#9E9E9E"/>

            </StackPanel>

            <!-- SEARCH -->

            <Border
                Grid.Row="1"
                Height="50"
                Background="#222222"
                CornerRadius="12">

                <Grid>

                    <TextBlock
                        Text="🔍"
                        FontSize="16"
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#888"/>

                    <TextBox
    x:Name="SearchBox"
    Margin="45,0,15,0"
    Background="Transparent"
    BorderThickness="0"
    Foreground="White"
    FontSize="14"
    VerticalContentAlignment="Center"
    TextChanged="SearchBox_TextChanged"/>
                </Grid>

            </Border>

            <!-- MEMBER LIST -->

            <Grid Grid.Row="3">

                <!-- LIST -->

                <ListBox
                    x:Name="MembersGrid"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Margin="0,0,0,12"
                                Padding="18"
                                Background="#202020"
                                CornerRadius="15">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <!-- AVATAR -->

                                    <Border
                                        Width="55"
                                        Height="55"
                                        Background="#4F8CFF"
                                        CornerRadius="28">

                                        <TextBlock
                                            Text="{Binding FullName}"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            FontSize="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                    <!-- INFO -->

                                    <StackPanel Grid.Column="1">

                                        <TextBlock
                                            Text="{Binding FullName}"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="White"/>

                                        <WrapPanel Margin="0,6,0,0">

                                            <TextBlock
                                                Text="📞 "
                                                Foreground="#BDBDBD"/>

                                            <TextBlock
                                                Text="{Binding PhoneNumber}"
                                                Foreground="#BDBDBD"/>

                                        </WrapPanel>

                                        <WrapPanel Margin="0,2,0,0">

                                            <TextBlock
                                                Text="🌍 "
                                                Foreground="#999999"/>

                                            <TextBlock
                                                Text="{Binding Country}"
                                                Foreground="#999999"/>

                                        </WrapPanel>

                                        <WrapPanel Margin="0,8,0,0">

                                            <TextBlock
                                                Text="Age: "
                                                Foreground="#CFCFCF"/>

                                            <TextBlock
                                                Text="{Binding Age}"
                                                Foreground="#CFCFCF"/>

                                            <TextBlock
                                                Text="   Gender: "
                                                Margin="15,0,0,0"
                                                Foreground="#CFCFCF"/>

                                            <TextBlock
                                                Text="{Binding Gender}"
                                                Foreground="#CFCFCF"/>

                                            <TextBlock
                                                Text="   Height: "
                                                Margin="15,0,0,0"
                                                Foreground="#CFCFCF"/>

                                            <TextBlock
                                                Text="{Binding Height}"
                                                Foreground="#CFCFCF"/>

                                            <TextBlock
                                                Text=" cm"
                                                Foreground="#CFCFCF"/>

                                            <TextBlock
                                                Text="   Weight: "
                                                Margin="15,0,0,0"
                                                Foreground="#CFCFCF"/>

                                            <TextBlock
                                                Text="{Binding Weight}"
                                                Foreground="#CFCFCF"/>

                                            <TextBlock
                                                Text=" kg"
                                                Foreground="#CFCFCF"/>

                                        </WrapPanel>

                                        <!-- BADGES -->

                                        <WrapPanel Margin="0,12,0,0">

                                            <!-- FITNESS LEVEL -->

                                            <Border
                                                Background="#2563EB"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="0,0,6,0">

                                                <TextBlock
                                                    Text="{Binding FitnessLevel}"
                                                    Foreground="White"
                                                    FontSize="11"/>

                                            </Border>

                                            <!-- GOAL -->

                                            <Border
                                                Background="#16A34A"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="0,0,6,0">

                                                <TextBlock
                                                    Text="{Binding FitnessGoal}"
                                                    Foreground="White"
                                                    FontSize="11"/>

                                            </Border>

                                            <!-- BMI -->

                                            <Border
                                                Background="#7C3AED"
                                                CornerRadius="6"
                                                Padding="8,4">

                                                <TextBlock
                                                    Text="{Binding BMI}"
                                                    Foreground="White"
                                                    FontSize="11"/>

                                            </Border>

                                        </WrapPanel>

                                    </StackPanel>

                                    <!-- SELECT BUTTON -->

                                    <Button
                                        Grid.Column="2"
                                        Width="130"
                                        Height="42"
                                        Margin="15,0,0,0"
                                        Content="✓ SELECT"
                                        Tag="{Binding}"
                                        Click="SelectButton_Click"
                                        Background="#4F8CFF"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

                <!-- EMPTY STATE -->

                <TextBlock
                    x:Name="EmptyStateText"
                    Text="No members found"
                    FontSize="18"
                    Foreground="#666666"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"/>

            </Grid>

            <!-- FOOTER -->

            <Grid Grid.Row="4"
                  Margin="0,20,0,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#888888"
                    Text="Double-click a member or use the Select button"/>

                <Button
                    Grid.Column="1"
                    Width="120"
                    Height="42"
                    Content="CLOSE"
                    Click="CloseButton_Click"
                    Background="#3A3A3A"/>

            </Grid>

        </Grid>

    </Border>

</Window>