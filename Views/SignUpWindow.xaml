<Window x:Class="FitZoneGymScheduler.Views.SignUpWindow"
         Icon="/Assets/icon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:FitZoneGymScheduler.Helpers"
        Title="Create Account"
        Height="720"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource PrimaryBackgroundBrush}">

    <Grid Margin="20">

        <!-- MAIN CARD -->

        <Border
            Background="#301934"
            CornerRadius="24"
            Padding="25">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ========================================================= -->
                <!-- LEFT PANEL -->
                <!-- ========================================================= -->

                <Border
                    Grid.Column="0"
                    Background="green"
                    CornerRadius="20"
                    Padding="25">

                    <StackPanel>

                        <TextBlock
                            Text="Staff Profile"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,25"/>

                        <!-- PROFILE IMAGE -->

                        <Border
                            Width="180"
                            Height="180"
                            CornerRadius="90"
                            BorderBrush="#3A3A3A"
                            BorderThickness="3"
                            HorizontalAlignment="Center"
                            Background="#222">

                            <Image
                                Source="{Binding ProfilePicturePath}"
                                Stretch="UniformToFill"/>
                        </Border>

                        <Button
                            Content="Upload Profile Picture"
                            Height="42"
                            Margin="0,25,0,0"
                            Command="{Binding BrowsePictureCommand}"/>

                        <Separator Margin="0,30,0,25"/>

                        <TextBlock
                            Text="Account Guidelines"
                            FontWeight="SemiBold"
                            FontSize="16"
                            Foreground="White"
                            Margin="0,0,0,12"/>

                        <TextBlock
                            Text="• Use a professional profile photo"
                            Foreground="#BFBFBF"
                            Margin="0,0,0,8"/>

                        <TextBlock
                            Text="• Create a unique username"
                            Foreground="#BFBFBF"
                            Margin="0,0,0,8"/>

                        <TextBlock
                            Text="• Use a strong password"
                            Foreground="#BFBFBF"
                            Margin="0,0,0,8"/>

                        <TextBlock
                            Text="• Verify email and phone number"
                            Foreground="#BFBFBF" Height="29"/>
                        <Border
                            Padding="15"
                            Background="#202020"
                            CornerRadius="12" Height="44">

                            <StackPanel Height="60">

                                <TextBlock
                                    Text="Account Preview"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,10"/>

                                <TextBlock
                                    Text="{Binding FullName}"
                                    Foreground="#EAEAEA"
                                    FontSize="14"/>

                                <TextBlock
                                    Text="{Binding Username}"
                                    Foreground="#AFAFAF"
                                    FontSize="13"
                                    Margin="0,4,0,0"/>

                                <TextBlock
                                    Text="{Binding SelectedRole}"
                                    Foreground="{StaticResource AccentBrush}"
                                    FontWeight="SemiBold"
                                    Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

                <!-- ========================================================= -->
                <!-- RIGHT PANEL -->
                <!-- ========================================================= -->

                <Grid Grid.Column="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,25">

                        <TextBlock
                            Text="Create Account"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="Silver"/>

                        <TextBlock
                            Text="Register a new staff account"
                            FontSize="14"
                            Foreground="#AFAFAF"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                    <!-- ROW 1 -->

                    <Grid Grid.Row="1"
                          Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- FULL NAME -->

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Full Name"
                                Foreground="#D0D0D0"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Height="46"
                                Padding="12"
                                FontSize="14"
                                Background="#1E1E1E"
                                BorderBrush="#333"
                                Foreground="White"
                                Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <!-- USERNAME -->

                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Username"
                                Foreground="#D0D0D0"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Height="46"
                                Padding="12"
                                FontSize="14"
                                Background="#1E1E1E"
                                BorderBrush="#333"
                                Foreground="White"
                                Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                    </Grid>

                    <!-- ROW 2 -->

                    <Grid Grid.Row="2"
                          Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Email Address"
                                Foreground="#D0D0D0"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Height="46"
                                Padding="12"
                                FontSize="14"
                                Background="#1E1E1E"
                                BorderBrush="#333"
                                Foreground="White"
                                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Phone Number"
                                Foreground="#D0D0D0"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Height="46"
                                Padding="12"
                                FontSize="14"
                                Background="#1E1E1E"
                                BorderBrush="#333"
                                Foreground="White"
                                Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                    </Grid>

                    <!-- ROLE -->

                    <StackPanel Grid.Row="3"
                                Margin="0,0,0,18">

                        <TextBlock
                            Text="Role"
                            Foreground="#D0D0D0"
                            Margin="0,0,0,6"/>

                        <ComboBox
                            Height="46"
                            Padding="8"
                            FontSize="14"
                            Background="#1E1E1E"
                            BorderBrush="#333"
                            Foreground="black"
                            ItemsSource="{Binding Roles}"
                            SelectedItem="{Binding SelectedRole}"/>

                    </StackPanel>

                    <!-- PASSWORDS -->

                    <Grid Grid.Row="4"
      Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- PASSWORD -->
                        <StackPanel Grid.Column="0">

                            <TextBlock
            Text="Password"
            Foreground="#D0D0D0"
            Margin="0,0,0,6"/>

                            <Grid>

                                <!-- HIDDEN PASSWORD -->
                                <PasswordBox
                Height="46"
                Padding="12"
                FontSize="14"
                Background="#1E1E1E"
                BorderBrush="#333"
                Foreground="White"
                helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}"
                Visibility="{Binding IsPasswordVisible,
                    Converter={StaticResource BoolToVisibilityConverter},
                    ConverterParameter=False}"/>

                                <!-- VISIBLE PASSWORD -->
                                <TextBox
                Height="46"
                Padding="12"
                FontSize="14"
                Background="#1E1E1E"
                BorderBrush="#333"
                Foreground="White"
                Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding IsPasswordVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}"/>

                            </Grid>

                        </StackPanel>

                        <!-- CONFIRM PASSWORD -->
                        <StackPanel Grid.Column="2">

                            <TextBlock
            Text="Confirm Password"
            Foreground="#D0D0D0"
            Margin="0,0,0,6"/>

                            <Grid>

                                <!-- HIDDEN -->
                                <PasswordBox
                Height="46"
                Padding="12"
                FontSize="14"
                Background="#1E1E1E"
                BorderBrush="#333"
                Foreground="White"
                helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}"
                Visibility="{Binding IsPasswordVisible,
                    Converter={StaticResource BoolToVisibilityConverter},
                    ConverterParameter=False}"/>

                                <!-- VISIBLE -->
                                <TextBox
                Height="46"
                Padding="12"
                FontSize="14"
                Background="#1E1E1E"
                BorderBrush="#333"
                Foreground="White"
                Text="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding IsPasswordVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}"/>

                            </Grid>

                        </StackPanel>

                    </Grid>

                    <!-- SHOW PASSWORD -->

                    <CheckBox
                        Grid.Row="5"
                        Content="Show Password"
                        IsChecked="{Binding IsPasswordVisible, Mode=TwoWay}"
                        Foreground="#BFBFBF"
                        FontSize="13"
                        VerticalAlignment="Top"
                        Margin="0,0,0,20"/>

                    <!-- ACTION BUTTONS -->

                    <StackPanel
                        Grid.Row="5"
                        VerticalAlignment="Bottom">

                        <Button
                            Content="CREATE ACCOUNT"
                            Height="52"
                            FontWeight="Bold"
                            FontSize="14"
                            Background="green"
                            Foreground="white"
                            BorderThickness="0"
                            Command="{Binding CreateAccountCommand}"
                            Margin="0,0,0,12"/>

                        <Button
                            Content="← BACK TO LOGIN"
                            Height="46"
                            FontSize="13"
                            Background="LightBlue"
                            Foreground="#301934"
                            BorderThickness="0"
                            Command="{Binding BackCommand}"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>