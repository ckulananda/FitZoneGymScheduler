<UserControl
    x:Class="FitZoneGymScheduler.Views.ExerciseLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#301934">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================================== -->
        <!-- LEFT CARD -->
        <!-- ===================================== -->

        <Border
            Grid.Column="0"
            Margin="20"
            Padding="25"
            Background="#301934"
            CornerRadius="12">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    ShadowDepth="2"
                    Opacity="0.25"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock
                        Text="Exercise Library"
                        FontSize="30"
                        FontFamily="Segoe UI Variable"
                        FontWeight="Bold"
                        Foreground="White"
                        Margin="0,0,0,25"/>

                    <!-- Exercise Name -->

                    <TextBlock
                        Text="Exercise Name"
                        Foreground="#CFCFCF"
                        Margin="0,0,0,5"/>

                    <TextBox
                        Height="45"
                        FontSize="15"
                        Padding="12"
                        Text="{Binding ExerciseName}"/>

                    <!-- Target Area -->

                    <TextBlock
                        Text="Target Area"
                        Foreground="#CFCFCF"
                        Margin="0,15,0,5"/>

                    <ComboBox
                        Height="45"
                        FontSize="15"
                        Padding="10"
                        ItemsSource="{Binding TargetAreas}"
                        SelectedItem="{Binding TargetArea}"/>

                    <!-- Difficulty -->

                    <TextBlock
                        Text="Difficulty"
                        Foreground="#CFCFCF"
                        Margin="0,15,0,5"/>

                    <ComboBox
                        Height="45"
                        FontSize="15"
                        Padding="10"
                        ItemsSource="{Binding DifficultyLevels}"
                        SelectedItem="{Binding Difficulty}"/>

                    <!-- Description -->

                    <TextBlock
                        Text="Description"
                        Foreground="#CFCFCF"
                        Margin="0,15,0,5"/>

                    <TextBox
                        Height="90"
                        Padding="12"
                        FontSize="15"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Text="{Binding Description}"/>

                    <!-- Notes -->

                    <TextBlock
                        Text="Notes"
                        Foreground="#CFCFCF"
                        Margin="0,15,0,5"/>

                    <TextBox
                        Height="130"
                        Padding="12"
                        FontSize="15"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        Text="{Binding Notes}"/>

                    <!-- Buttons -->

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,25,0,0">

                        <Button
                            Content="💾 Save"
                            Width="100"
                            Height="45"
                            Margin="0,0,10,0"
                            Background="#3B82F6"
                            Foreground="White"
                            Command="{Binding SaveExerciseCommand}"/>

                        <Button
                            Content="✏ Update"
                            Width="100"
                            Height="45"
                            Margin="0,0,10,0"
                            Background="#6366F1"
                            Foreground="White"
                            Command="{Binding UpdateExerciseCommand}"/>

                        <Button
                            Content="🗑 Delete"
                            Width="100"
                            Height="45"
                            Background="#DC2626"
                            Foreground="White"
                            Command="{Binding DeleteExerciseCommand}"/>

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </Border>

        <!-- ===================================== -->
        <!-- RIGHT CARD -->
        <!-- ===================================== -->

        <Border
            Grid.Column="1"
            Margin="20"
            Padding="20"
            Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="12">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    ShadowDepth="2"
                    Opacity="0.25"/>
            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search -->

                <Grid Grid.Row="0"
      Margin="0,0,0,15">

                    <TextBox
        Height="45"
        Padding="35,0,10,0"
        FontSize="15"
        VerticalContentAlignment="Center"
        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
        Text="🔍"
        FontSize="16"
        Foreground="Gray"
        VerticalAlignment="Center"
        HorizontalAlignment="Left"
        Margin="10,0,0,0"
        Panel.ZIndex="1"
        IsHitTestVisible="False"/>

                </Grid>

                <!-- DataGrid -->

                <DataGrid
                    Grid.Row="1"
                    ItemsSource="{Binding Exercises}"
                    SelectedItem="{Binding SelectedExercise}"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    RowHeight="45"
                    HeadersVisibility="Column"
                    GridLinesVisibility="None"
                    AlternatingRowBackground="#292929">

                    <DataGrid.Resources>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#323232"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="45"/>
                            <Setter Property="FontSize" Value="14"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#242424"/>
                            <Setter Property="Foreground" Value="White"/>

                            <Style.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#353535"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="Exercise"
                            Width="220"
                            Binding="{Binding ExerciseName}"/>

                        <DataGridTextColumn
                            Header="Target Area"
                            Width="150"
                            Binding="{Binding TargetArea}"/>

                        <DataGridTextColumn
                            Header="Difficulty"
                            Width="120"
                            Binding="{Binding Difficulty}"/>

                        <DataGridTextColumn
                            Header="Description"
                            Width="250"
                            Binding="{Binding Description}"/>

                        <DataGridTextColumn
                            Header="Notes"
                            Width="300"
                            Binding="{Binding Notes}"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</UserControl>